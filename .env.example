# ═══════════════════════════════════════════════════════════════
# SARGE AI Builder v2 — Environment Variables Template
# Copy this file to .env.local and fill in your API keys.
# .env.local is gitignored — your keys stay local.
# ═══════════════════════════════════════════════════════════════

# ─── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Cloud AI Providers ────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# ─── Local AI Endpoints ────────────────────────────────────────
LOCAL_AI_ENDPOINT=http://localhost:1234/v1
NEXT_PUBLIC_OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
LMStudio_API_KEY=
LM_STUDIO_API_KEY=
NEXT_PUBLIC_LM_STUDIO_URL=http://127.0.0.1:1240/v1

# ─── Search APIs ───────────────────────────────────────────────
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
SEARXNG_URL=http://localhost:8080

# ─── Voice ─────────────────────────────────────────────────────
NEXT_PUBLIC_XTTS_URL=http://localhost:8787

# ─── Builder ───────────────────────────────────────────────────
BUILDER_PROJECTS_DIR=

# ─── Trading APIs ──────────────────────────────────────────────
ALPACA_API_KEY=
ALPACA_API_SECRET=
FINNHUB_API_KEY=
FINNHUB_API_SECRET=
POLYGON_API_KEY=
POLYGON_API_SECRET=

# ─── Feature Flags ─────────────────────────────────────────────
AIR_GAP_MODE=false

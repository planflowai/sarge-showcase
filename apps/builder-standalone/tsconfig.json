{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@sarge/core": [
        "../../packages/core/src/index.ts"
      ],
      "@sarge/core/index.client": [
        "../../packages/core/src/index.client.ts"
      ],
      "@sarge/core/*": [
        "../../packages/core/src/*"
      ],
      "@sarge/chat": [
        "../../packages/chat/src/index.ts"
      ],
      "@sarge/chat/index.client": [
        "../../packages/chat/src/index.client.ts"
      ],
      "@sarge/chat/*": [
        "../../packages/chat/src/*"
      ],
      "@sarge/builder": [
        "../../packages/builder/src/index.ts"
      ],
      "@sarge/builder/index.client": [
        "../../packages/builder/src/index.client.ts"
      ],
      "@sarge/builder/*": [
        "../../packages/builder/src/*"
      ],
      "@sarge/benchmark": [
        "../../packages/benchmark/src/index.ts"
      ],
      "@sarge/benchmark/*": [
        "../../packages/benchmark/src/*"
      ],
      "@sarge/audit": [
        "../../packages/audit/src/index.ts"
      ],
      "@sarge/audit/*": [
        "../../packages/audit/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
